{
  "name": "symdy",
  "version": "0.1.0",
  "description": "Symdy — Your AI companion. A persistent cognitive dyad.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --linux --win --mac",
    "build:ci": "electron-builder --linux --publish=never"
  },
  "build": {
    "appId": "dev.symdy.app",
    "productName": "Symdy",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraFiles": [
      "assets/icon-*.png"
    ],
    "icon": "assets/icon-512.png",
    "mac": {
      "target": "dmg",
      "icon": "assets/icon-512.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon-256.png",
      "category": "Utility"
    }
  },
  "author": "Symdy <dev@symdy.app>",
  "dependencies": {},
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.8.1"
  }
}
